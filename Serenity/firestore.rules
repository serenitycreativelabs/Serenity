rules_version = '2';
// =====================================================================
//  Serenity v2.4.0 “Nebula” — Firestore Security Rules (diperketat)
//  Powered by Serenity Creativa Labs. © 2026 All Rights Reserved
//
//  Prinsip:
//   • Default TOLAK semua. Hanya jalur yang didefinisikan di bawah yang dibuka.
//   • Publik (tanpa login) hanya BACA data non-pribadi, dengan batas jumlah dokumen per query
//     (mencegah bot menyedot data & membengkakkan kuota).
//   • Semua TULIS wajib login + profil aktif di /users + hak akses yang sesuai.
//   • Validasi skema: field yang diizinkan, tipe data, dan ukuran maksimum (anti spam/abuse).
//   • Kepala Dusun (kadus) DIKUNCI hanya pada warga dusunnya sendiri.
//   • Audit log hanya bisa DITAMBAH — tidak bisa diubah/dihapus siapa pun.
//   • Badge, penugasan pengelola lembaga, tema, ikon, widget: hanya Super Admin.
//   • v2.4: akun Super Admin tidak dapat dibaca siapa pun selain Super Admin; admin bercentang hijau
//     (Perangkat Gampong) dapat melihat akun Admin & Kadus; versi sinkron (meta), catatan hapus,
//     analitik kunjungan, kehadiran & pemakaian divalidasi ketat (hanya penambahan bertahap).
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identitas & peran
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function me() { return get(userPath()).data; }
    function isStaff() { return hasProfile() && me().active == true; }
    function isSuper() { return isStaff() && me().role == 'superadmin'; }
    function isKadus() { return isStaff() && me().role == 'kadus'; }
    function kadusPerm(p) { return p in ['warga', 'wargaEdit', 'wargaDelete', 'export', 'broadcast']; }
    function can(p) {
      return isSuper() || (isStaff() && me().perms.get(p, false) == true && (me().role != 'kadus' || kadusPerm(p)));
    }
    function sameDusun(d) { return !isKadus() || d.dusun == me().dusun; }
    // Admin yang diangkat Super Admin sebagai pengelola lembaga tertentu (bukan kategori Pemerintahan)
    function pengelola(id) { return isStaff() && me().role == 'admin' && id in me().get('lembagaIds', []); }
    // Admin yang diberi badge Centang Hijau — Perangkat Gampong oleh Super Admin
    function isGreen() { return isStaff() && me().role == 'admin' && me().get('badges', []).hasAny([{ 'id': 'verified-green' }, 'verified-green']); }

    // ---------- Helper validasi
    function data() { return request.resource.data; }
    function changedOnly(keys) { return data().diff(resource.data).affectedKeys().hasOnly(keys); }
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(k, max) { return !(k in data()) || str(data()[k], max); }
    function smallList() { return request.query.limit != null && request.query.limit <= 200; }
    // Kunci hari WIB (UTC+7) — kemarin, hari ini, besok (toleransi jam perangkat)
    function dk(t) { return string(t.year()) + '_' + string(t.month()) + '_' + string(t.day()); }
    function wib() { return request.time + duration.value(7, 'h'); }
    function dayKeys() { return [dk(wib() - duration.value(1, 'd')), dk(wib()), dk(wib() + duration.value(1, 'd'))]; }

    // Super Admin utama dibuat otomatis saat login pertama dengan email ini
    function bootstrapSuper(uid) {
      return signedIn() && request.auth.uid == uid
        && request.auth.token.email == 'serenityxcreative@gmail.com'
        && data().role == 'superadmin' && data().active == true;
    }

    // ================================================= /users
    function userKeysOk() {
      return data().keys().hasOnly(['email', 'nama', 'jabatan', 'hp', 'role', 'active', 'perms', 'dusun', 'dusunId',
        'foto', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'lastLogin', 'lembagaIds', 'badges'])
        && optStr('nama', 120) && optStr('jabatan', 120) && optStr('hp', 20) && optStr('foto', 200000)
        && optStr('dusun', 100) && (!('perms' in data()) || data().perms is map)
        && (!('lembagaIds' in data()) || (data().lembagaIds is list && data().lembagaIds.size() <= 20))
        && (!('badges' in data()) || (data().badges is list && data().badges.size() <= 30));
    }
    // Badge & penugasan lembaga tidak boleh disentuh selain oleh Super Admin
    function noSuperFields() {
      return resource == null ? !data().keys().hasAny(['badges', 'lembagaIds'])
                              : !data().diff(resource.data).affectedKeys().hasAny(['badges', 'lembagaIds']);
    }
    function kadusDocOk() {
      return data().role == 'kadus' && str(data().dusun, 100) && data().dusun.size() > 0
        && data().perms.keys().hasOnly(['warga', 'wargaEdit', 'wargaDelete', 'export', 'broadcast'])
        && !('lembagaIds' in data());
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuper()
        || ((can('kelolaKadus') || isGreen()) && resource.data.role == 'kadus')
        || (isGreen() && resource.data.role == 'admin'));
      // Non-Super Admin wajib memfilter where('role','==','kadus' | 'admin') — dokumen Super Admin tak pernah terbaca
      allow list: if isSuper()
        || ((can('kelolaKadus') || isGreen()) && resource.data.role == 'kadus')
        || (isGreen() && resource.data.role == 'admin');
      allow create: if userKeysOk() && (
        (isSuper() && data().role in ['admin', 'kadus'] && (data().role != 'kadus' || kadusDocOk()))
        || (can('kelolaKadus') && kadusDocOk() && noSuperFields())
        || (!exists(userPath()) && bootstrapSuper(uid)));
      allow update: if userKeysOk() && (
        (isSuper() && uid != request.auth.uid && resource.data.role in ['admin', 'kadus'] && data().role == resource.data.role && (data().role != 'kadus' || kadusDocOk()))
        || (can('kelolaKadus') && !isSuper() && uid != request.auth.uid && resource.data.role == 'kadus' && kadusDocOk() && noSuperFields())
        || (isSuper() && uid == request.auth.uid && data().role == 'superadmin' && data().active == true)
        || (isStaff() && uid == request.auth.uid && changedOnly(['lastLogin', 'email', 'nama', 'foto'])));
      allow delete: if uid != request.auth.uid && (
        (isSuper() && resource.data.role in ['admin', 'kadus'])
        || (can('kelolaKadus') && resource.data.role == 'kadus'));
    }

    // ================================================= /config
    function protectedCfg() { return ['tema', 'layout', 'ikon', 'latar', 'widget']; }
    function noProtectedCfg() {
      return resource == null ? !data().keys().hasAny(protectedCfg())
                              : !data().diff(resource.data).affectedKeys().hasAny(protectedCfg());
    }
    function ikonOk() { return !('ikon' in data()) || (data().ikon is map && data().ikon.size() <= 5 && (!('src' in data().ikon) || str(data().ikon.src, 200000))); }
    function latarOk() {
      return !('latar' in data()) || (data().latar is map && data().latar.size() <= 14
        && (!('url' in data().latar) || (str(data().latar.url, 1000) && (data().latar.url == '' || data().latar.url.matches('^https://.*'))))
        && (!('poster' in data().latar) || (str(data().latar.poster, 1000) && (data().latar.poster == '' || data().latar.poster.matches('^https://.*')))));
    }
    match /config/{docId} {
      allow get: if docId in ['app', 'stats', 'auth'];
      allow list: if false;
      // Tema, tata letak & ikon: hanya Super Admin. Latar belakang: Super Admin atau izin 'latar'.
      allow write: if (docId == 'app' && can('pengaturan') && data().size() <= 70 && optStr('logo', 300000)
                        && (!('runningText' in data()) || data().runningText is map) && noProtectedCfg())
        || (docId == 'app' && isSuper() && data().size() <= 70 && optStr('logo', 300000) && ikonOk() && latarOk())
        || (docId == 'app' && can('latar') && resource != null && changedOnly(['latar']) && latarOk())
        || (docId == 'app' && can('instagram') && resource != null && changedOnly(['igLastSync', 'igUsername']))
        || (docId == 'stats' && can('warga') && !isKadus() && data().size() <= 40)
        || (docId == 'auth' && isSuper());
    }

    // ================================================= /warga (data pribadi)
    function wargaOk() {
      return data().size() <= 120
        && str(data().nama, 200) && data().nama.size() > 0
        && (!('nik' in data()) || (data().nik is string && data().nik.matches('^[0-9]{0,16}$')))
        && (!('noKk' in data()) || (data().noKk is string && data().noKk.matches('^[0-9]{0,16}$')))
        && optStr('noHp', 20) && optStr('alamat', 300) && optStr('dusun', 100) && optStr('ketPeristiwa', 1000);
    }
    match /warga/{id} {
      allow read: if can('warga') && sameDusun(resource.data);
      allow create: if (can('wargaEdit') || can('import')) && wargaOk() && sameDusun(data());
      allow update: if (((can('wargaEdit') || can('import')) && wargaOk() && sameDusun(resource.data) && sameDusun(data()))
        || (can('dusun') && !isKadus() && changedOnly(['dusun', 'updatedAt'])));
      allow delete: if can('wargaDelete') && sameDusun(resource.data);
    }

    // ================================================= /dusun
    match /dusun/{id} {
      allow read: if isStaff();
      allow create: if (can('dusun') || ((can('wargaEdit') || can('import')) && !isKadus())) && str(data().nama, 100) && data().size() <= 20;
      allow update: if can('dusun') && str(data().nama, 100) && data().size() <= 20;
      allow delete: if can('dusun');
    }

    // ================================================= /master (pilihan dropdown)
    match /master/{id} {
      allow read: if isStaff();
      // PERBAIKAN v2.4: hapus kategori sebelumnya selalu ditolak (request.resource bernilai null saat delete)
      allow delete: if can('master');
      allow create, update: if can('master') && (!('items' in data()) || (data().items is list && data().items.size() <= 1000));
      allow create, update: if (can('wargaEdit') || can('import') || can('informasi') || can('kegiatan') || can('dokumen') || can('lembaga'))
        && data().keys().hasOnly(['items', 'label', 'builtin', 'group', 'order', 'custom', 'deleted', 'syncAt'])
        && data().items is list && data().items.size() <= 1000
        && (resource == null || changedOnly(['items', 'label', 'syncAt']));
    }

    // ================================================= Publikasi (dibaca publik, dibatasi per query)
    function infoOk() {
      return data().size() <= 30 && str(data().judul, 200) && str(data().isi, 40000)
        && (!('media' in data()) || (data().media is list && data().media.size() <= 30))
        && data().published is bool && optStr('gambar', 900000) && optStr('kategori', 80) && optStr('lokasi', 200);
    }
    match /informasi/{id} {
      allow get: if isStaff() || resource.data.published == true;
      allow list: if isStaff() || (resource.data.published == true && smallList());
      allow create, update: if can('informasi') && infoOk();
      allow delete: if can('informasi');
      allow update: if can('broadcast') && changedOnly(['broadcastCount', 'lastBroadcast', 'syncAt']);
    }
    match /instagram/{id} {
      allow get: if true;
      allow list: if isStaff() || smallList();
      allow write: if can('instagram') && (request.resource == null || (data().size() <= 20 && optStr('caption', 3000) && optStr('mediaUrl', 900000)));
    }
    match /halaman/{id} {
      allow get: if true;
      allow list: if isStaff() || smallList();
      allow write: if can('profil') && id in ['profil', 'sejarah', 'visimisi', 'struktur', 'lembaga', 'layanan', 'apbdes', 'potensi', 'kontak'];
    }
    match /kegiatan/{id} {
      allow get: if true;
      allow list: if isStaff() || smallList();
      allow create, update: if can('kegiatan') && data().size() <= 20 && str(data().nama, 150) && optStr('keterangan', 1000);
      allow delete: if can('kegiatan');
    }
    // ---------- Lembaga Gampong (profil, pengurus, berita, galeri, dokumen = publik)
    function lembagaOk() {
      return data().size() <= 40 && str(data().nama, 200) && data().nama.size() > 0
        && data().kategori in ['pemerintahan', 'adat', 'lkg', 'ekonomi', 'pendidikan']
        && optStr('deskripsi', 30000) && optStr('logo', 300000)
        && (!('pengurus' in data()) || (data().pengurus is list && data().pengurus.size() <= 300))
        && (!('berita' in data()) || (data().berita is list && data().berita.size() <= 200))
        && (!('media' in data()) || (data().media is list && data().media.size() <= 100))
        && (!('dokumen' in data()) || (data().dokumen is list && data().dokumen.size() <= 200));
    }
    // Pengelola: hanya lembaga yang ditugaskan, kategori non-Pemerintahan, tidak boleh memindah kategori
    function pengelolaLembaga(id) {
      return pengelola(id) && resource != null && resource.data.kategori in ['adat', 'lkg', 'ekonomi', 'pendidikan']
        && data().kategori == resource.data.kategori;
    }
    match /lembaga/{id} {
      allow get: if isStaff() || resource.data.published != false;
      allow list: if isStaff() || (resource.data.published == true && smallList());
      allow create: if can('lembaga') && lembagaOk();
      allow update: if lembagaOk() && (can('lembaga') || pengelolaLembaga(id));
      allow delete: if can('lembaga');
    }
    // Anggota & murid/santri lembaga = data pribadi (hanya admin berizin / pengelola lembaga itu)
    function pengelolaPrivate(id) {
      return pengelola(id) && get(/databases/$(database)/documents/lembaga/$(id)).data.kategori in ['adat', 'lkg', 'ekonomi', 'pendidikan'];
    }
    match /lembagaPrivate/{id} {
      allow read: if can('lembaga') || pengelolaPrivate(id);
      allow delete: if can('lembaga');
      allow create, update: if (can('lembaga') || pengelolaPrivate(id)) && data().size() <= 5
        && (!('anggota' in data()) || (data().anggota is list && data().anggota.size() <= 2000))
        && (!('peserta' in data()) || (data().peserta is list && data().peserta.size() <= 2000));
    }
    // ---------- Dokumen publik gampong (RPJMG, APBG, Reusam, dll.)
    match /dokumen/{id} {
      allow get: if isStaff() || resource.data.published != false;
      allow list: if isStaff() || (resource.data.published == true && smallList());
      allow create, update: if can('dokumen') && data().size() <= 25 && str(data().judul, 300) && str(data().jenis, 100)
        && str(data().url, 2000) && data().url.matches('^https://.*') && optStr('deskripsi', 10000);
      allow delete: if can('dokumen');
    }

    match /private/{id} {
      allow read, write: if can('instagram');
    }

    // ================================================= v2.4 Sinkron bertahap (delta sync)
    // meta/pub & meta/adm: cap waktu perubahan terakhir per koleksi. Nilai WAJIB = waktu server saat itu.
    function metaVal(k) { return !(k in data()) || (resource != null && k in resource.data && data()[k] == resource.data[k]) || data()[k] == request.time; }
    function metaPubOk() {
      return data().keys().hasOnly(['informasi', 'lembaga', 'dokumen', 'kegiatan', 'halaman', 'instagram', 'cfg_app', 'cfg_stats'])
        && metaVal('informasi') && metaVal('lembaga') && metaVal('dokumen') && metaVal('kegiatan') && metaVal('halaman')
        && metaVal('instagram') && metaVal('cfg_app') && metaVal('cfg_stats');
    }
    function metaAdmOk() { return data().keys().hasOnly(['warga', 'dusun', 'master']) && metaVal('warga') && metaVal('dusun') && metaVal('master'); }
    match /meta/{id} {
      allow get: if id == 'pub' || (id == 'adm' && isStaff());
      allow list: if false;
      allow create, update: if isStaff() && ((id == 'pub' && metaPubOk()) || (id == 'adm' && metaAdmOk()));
      allow delete: if false;
    }
    // Catatan ID yang dihapus (agar perangkat admin lain ikut menghapus tanpa memuat ulang semua data)
    match /hapus/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && data().keys().hasOnly(['c', 'ids', 'at']) && data().at == request.time
        && data().c in ['informasi', 'lembaga', 'dokumen', 'kegiatan', 'halaman', 'instagram', 'warga', 'dusun', 'master']
        && data().ids is list && data().ids.size() <= 500;
      allow update: if false;
      allow delete: if isSuper();
    }

    // ================================================= v2.4 Analitik kunjungan (publik, tanpa data pribadi)
    function visitStep(h0, h1, k) { return h1.get(k, 0) == h0.get(k, 0) || h1.get(k, 0) == h0.get(k, 0) + 1; }
    function visitOk() {
      return data().keys().hasOnly(['total', 'harian']) && data().harian is map
        && data().total == resource.data.get('total', 0) + 1
        && data().harian.diff(resource.data.get('harian', {})).affectedKeys().size() == 1
        && data().harian.diff(resource.data.get('harian', {})).affectedKeys().hasOnly(dayKeys())
        && visitStep(resource.data.get('harian', {}), data().harian, dayKeys()[0])
        && visitStep(resource.data.get('harian', {}), data().harian, dayKeys()[1])
        && visitStep(resource.data.get('harian', {}), data().harian, dayKeys()[2]);
    }
    match /analytics/{id} {
      allow get: if id == 'summary';
      allow list: if false;
      allow create: if id == 'summary' && data().keys().hasOnly(['total', 'harian']) && data().total == 1
        && data().harian is map && data().harian.size() == 1 && data().harian.keys().hasOnly(dayKeys());
      allow update: if id == 'summary' && visitOk();
      allow delete: if false;
    }
    // Kehadiran (online sekarang): hanya cap waktu. Hitungan memakai count aggregation (wajib limit ≤ 1000).
    match /presence/{sid} {
      allow get: if false;
      allow list: if request.query.limit != null && request.query.limit <= 1000;
      allow create, update: if sid.size() <= 40 && data().keys().hasOnly(['at', 'exp']) && data().at == request.time
        && data().exp is timestamp && data().exp < request.time + duration.value(1, 'd');
      allow delete: if isSuper();
    }
    // Pemakaian Firestore per hari (estimasi aplikasi) — hanya boleh bertambah, dengan batas per kiriman
    function incOk(f, mx) {
      return !(f in data()) || (data()[f] is int && (
        (resource == null && data()[f] >= 0 && data()[f] <= mx)
        || (resource != null && data()[f] >= resource.data.get(f, 0) && data()[f] <= resource.data.get(f, 0) + mx)));
    }
    match /usage/{day} {
      allow read: if isSuper();
      allow create, update: if day in dayKeys()
        && data().keys().hasOnly(['day', 'n', 'r', 'w', 'd', 'dl', 'ul', 'sv', 'pr', 'ar'])
        && str(data().day, 10)
        && incOk('n', 1) && incOk('r', 100000) && incOk('w', 20000) && incOk('d', 20000)
        && incOk('dl', 1000) && incOk('ul', 1000) && incOk('sv', 100000) && incOk('pr', 100000) && incOk('ar', 100000);
      allow delete: if false;
    }
    // Pengaturan sistem (pengingat cadangan, dll.) — khusus Super Admin
    match /sistem/{id} {
      allow read, write: if isSuper();
    }

    // ================================================= /audit — hanya tambah, tidak bisa diubah/dihapus
    match /audit/{id} {
      allow create: if isStaff()
        && data().uid == request.auth.uid
        && data().at == request.time
        && data().size() <= 20
        && str(data().label, 300) && str(data().cat, 30) && str(data().action, 60)
        && optStr('detail', 1000) && optStr('target', 200);
      allow read: if isSuper();
      allow update, delete: if false;
    }

    // ================================================= Selain di atas: TOLAK
    match /{document=**} { allow read, write: if false; }
  }
}
