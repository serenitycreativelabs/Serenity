{
  "name": "DigiDes — Sistem Informasi Desa Digital",
  "short_name": "DigiDes",
  "description": "Aplikasi desa: data warga, dusun, papan informasi, highlight Instagram & WhatsApp warga. © Serenity Creativa 2026",
  "id": "./",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f5f4ef",
  "theme_color": "#0f766e",
  "lang": "id",
  "dir": "ltr",
  "categories": ["government", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Data Warga", "url": "./#/admin/warga", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tambah Warga", "url": "./#/admin/warga/baru", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Papan Informasi", "url": "./#/informasi", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
